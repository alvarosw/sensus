{
  "name": "sensus",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/core --noEmit && tsc -p app --noEmit",
    "test": "vitest run",
    "test:arch": "vitest run tests",
    "check": "npm run typecheck && vitest run",
    "ask": "tsx packages/core/tools/ask.ts",
    "release:version": "node scripts/release.mjs version",
    "release:check": "node scripts/release.mjs check",
    "release:android": "node scripts/release.mjs android",
    "release:ios": "node scripts/release.mjs ios",
    "release:github": "node scripts/release.mjs github"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
